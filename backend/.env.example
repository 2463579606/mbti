# Application
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_password_here
DB_DATABASE=mbti_test
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=your_jwt_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Session
SESSION_TOKEN_TTL=7200
SHARE_TOKEN_TTL=604800

# Cache TTL (seconds)
CACHE_TTL_QUESTIONS=3600
CACHE_TTL_MBTI_TYPES=86400
CACHE_TTL_REPORTS=604800
CACHE_TTL_STATS=300

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_USER_MAX=200

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=logs

# CORS
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:3000
