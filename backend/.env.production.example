# Production Environment Configuration
# Copy this file to .env.production and fill in the actual values

# ===== Application =====
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1

# ===== Database =====
DB_HOST=your-production-db-host
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=mbti_prod
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===== Redis =====
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# ===== JWT =====
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ===== AI Configuration =====
AI_ENABLED=true
AI_PROVIDER=zhipu
AI_API_KEY=your-zhipu-api-key
AI_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/chat/completions
AI_MODEL=glm-4.7
ZHIPU_CODING_PLAN=true

# AI Queue Settings
AI_QUEUE_ENABLED=true
AI_QUEUE_MAX_CONCURRENT=3
AI_QUEUE_MAX_RETRIES=3
AI_QUEUE_RETRY_DELAY=5000

# AI Cache Settings
AI_CACHE_ENABLED=true
AI_CACHE_TTL=86400
AI_CACHE_SIMILARITY_THRESHOLD=0.85

# ===== Rate Limiting =====
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60
RATE_LIMIT_IP_MAX=100
RATE_LIMIT_USER_MAX=200

# ===== CORS =====
CORS_ORIGIN=https://your-frontend-domain.com
CORS_CREDENTIALS=true

# ===== Logging =====
LOG_LEVEL=info
LOG_FORMAT=json

# ===== Monitoring =====
SENTRY_DSN=your-sentry-dsn
SENTRY_ENVIRONMENT=production

# ===== Email (Optional) =====
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=noreply@your-domain.com

# ===== File Upload =====
MAX_FILE_SIZE=5242880
UPLOAD_DIR=/var/uploads

# ===== Analytics (Optional) =====
GOOGLE_ANALYTICS_ID=your-ga-id
