{
  "name": "mbti-backend",
  "version": "1.0.0",
  "description": "MBTI Personality Test Backend API",
  "main": "dist/cmd/api/main.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cmd/api/main.js",
    "dev": "ts-node-dev --respawn --transpile-only cmd/api/main.ts",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration",
    "test:e2e": "jest --selectProjects e2e",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint '{src,tests}/**/*.ts'",
    "lint:fix": "eslint '{src,tests}/**/*.ts' --fix",
    "format": "prettier --write '{src,tests}/**/*.ts'",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/config/data-source.ts"
  },
  "keywords": [
    "mbti",
    "personality",
    "test",
    "api"
  ],
  "author": "MBTI Team",
  "license": "MIT",
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/throttler": "^5.1.1",
    "@nestjs/typeorm": "^11.0.1",
    "@types/bull": "^3.15.9",
    "@types/ioredis": "^4.28.10",
    "bcrypt": "^5.1.1",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.1",
    "passport": "^0.7.0",
    "passport-anonymous": "^1.0.1",
    "passport-jwt": "^4.0.1",
    "pg": "^8.11.3",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.19",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.5",
    "@types/passport-jwt": "^4.0.0",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.1.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "projects": [
      {
        "displayName": "unit",
        "testMatch": [
          "**/tests/unit/**/*.spec.ts"
        ]
      },
      {
        "displayName": "integration",
        "testMatch": [
          "**/tests/integration/**/*.spec.ts"
        ]
      },
      {
        "displayName": "e2e",
        "testMatch": [
          "**/tests/e2e/**/*.spec.ts"
        ]
      }
    ]
  }
}
